/* ---------------- STATE ---------------- */
let totalStars = 0;
let totalScore = 0;
let levelStars = new Array(levels.length).fill(0);
let unlockedUpTo = 0; // index of highest unlocked level

let currentLevelIndex = 0;
let currentQIndex = 0;
let hearts = 3;
let correctCount = 0;
let answered = false;

/* ---------------- RENDER MAP ---------------- */
function renderMap(){
  document.getElementById('totalStars').textContent = totalStars;
  document.getElementById('totalScore').textContent = totalScore;

  const pathList = document.getElementById('pathList');
  pathList.innerHTML = '';
  levels.forEach((lvl, i) => {
    const state = i > unlockedUpTo ? 'locked' : (levelStars[i] > 0 ? 'done' : 'unlocked');
    const row = document.createElement('div');
    row.className = 'level-row';

    const starsHtml = [1,2,3].map(n =>
      `<span class="${n <= levelStars[i] ? 'lit' : ''}">★</span>`
    ).join('');

    row.innerHTML = `
      <div class="level-node ${state}" onclick="${state !== 'locked' ? `startLevel(${i})` : ''}">
        ${state === 'locked' ? '🔒' : (state === 'done' ? '✓' : lvl.icon)}
      </div>
      <div class="level-info">
        <div class="lv-title">${lvl.title}</div>
        <div class="lv-sub">${lvl.sub}</div>
        <div class="level-stars">${starsHtml}</div>
      </div>
    `;
    pathList.appendChild(row);
  });
}

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function backToMap(){
  renderMap();
  showScreen('mapScreen');
}

/* ---------------- QUIZ LOGIC ---------------- */
function startLevel(index){
  currentLevelIndex = index;
  currentQIndex = 0;
  hearts = 3;
  correctCount = 0;
  document.getElementById('gameOverPanel').classList.remove('show');
  document.getElementById('optionsList').style.display = 'flex';
  renderQuestion();
  showScreen('quizScreen');
}

function renderHearts(){
  const el = document.getElementById('heartsDisplay');
  el.innerHTML = '';
  for(let i=0;i<3;i++){
    el.innerHTML += i < hearts ? '❤️' : '🖤';
  }
}

function renderQuestion(){
  answered = false;
  const lvl = levels[currentLevelIndex];
  const q = lvl.questions[currentQIndex];

  renderHearts();
  const pct = (currentQIndex / lvl.questions.length) * 100;
  document.getElementById('progressFill').style.width = pct + '%';

  document.getElementById('qTag').textContent = q.tag;
  document.getElementById('qPrompt').textContent = q.prompt;
  document.getElementById('qZh').textContent = q.zh;

  const letters = ['A','B','C','D'];
  const optsEl = document.getElementById('optionsList');
  optsEl.innerHTML = '';
  q.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.innerHTML = `<span class="opt-letter">${letters[i]}</span><span>${opt}</span>`;
    btn.onclick = () => selectAnswer(i);
    optsEl.appendChild(btn);
  });

  document.getElementById('feedback').classList.remove('show');
  document.getElementById('nextBtn').classList.remove('show');
}

function selectAnswer(i){
  if(answered) return;
  answered = true;
  const lvl = levels[currentLevelIndex];
  const q = lvl.questions[currentQIndex];
  const opts = document.querySelectorAll('.option');

  opts.forEach((btn, idx) => {
    btn.classList.add('disabled');
    if(idx === q.correct) btn.classList.add('correct');
    if(idx === i && i !== q.correct) btn.classList.add('wrong');
  });

  const fb = document.getElementById('feedback');
  const fbHead = document.getElementById('fbHead');
  const fbBody = document.getElementById('fbBody');
  fb.classList.add('show');

  if(i === q.correct){
    correctCount++;
    totalScore += 10;
    fbHead.textContent = '✅ 答對了！';
    fbHead.className = 'fb-head ok';
  } else {
    hearts--;
    fbHead.textContent = '❌ 差一點點！';
    fbHead.className = 'fb-head no';
  }
  fbBody.textContent = q.exp;

  document.getElementById('totalScore').textContent = totalScore;

  if(hearts <= 0){
    setTimeout(() => {
      document.getElementById('optionsList').style.display = 'none';
      document.getElementById('gameOverPanel').classList.add('show');
    }, 400);
    return;
  }

  document.getElementById('nextBtn').classList.add('show');
}

function nextQuestion(){
  const lvl = levels[currentLevelIndex];
  if(currentQIndex < lvl.questions.length - 1){
    currentQIndex++;
    renderQuestion();
  } else {
    finishLevel();
  }
}

function finishLevel(){
  const lvl = levels[currentLevelIndex];
  const total = lvl.questions.length;
  let stars = 1;
  if(correctCount === total) stars = 3;
  else if(correctCount >= Math.ceil(total * 0.6)) stars = 2;

  if(stars > levelStars[currentLevelIndex]){
    totalStars += (stars - levelStars[currentLevelIndex]);
    levelStars[currentLevelIndex] = stars;
  }
  if(currentLevelIndex === unlockedUpTo && unlockedUpTo < levels.length - 1){
    unlockedUpTo++;
  }

  document.getElementById('resultTitle').textContent = lvl.title + ' 過關！';
  document.getElementById('resultStars').textContent = '★★★'.slice(0, 0) +
    Array.from({length:3}, (_,i) => i < stars ? '★' : '☆').join('');
  document.getElementById('resultLine').textContent =
    `答對 ${correctCount} / ${total} 題，獲得 ${stars} 顆星`;

  showScreen('resultScreen');
}

/* ---------------- INIT ---------------- */
renderMap();
</script>
